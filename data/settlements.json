       "shop": {
        "type": "cantina",
        "locationId": "vorrn-7",
        "wealth": 2,
        "size": "small",
        "name": "The Frostwatch Tab"
       },
       "wander": false,
       "quest": true,
       "blurb": "Broad, unhurried, and missing two fingers on the pouring hand. Has run the Tab for eleven years and can price a stranger before they reach the counter.",
       "talkingPoints": [
        "You'll be the ones who came down hard on the north flats. Heard your engines from here.",
        "Fuel's at the pad. Ilsa's at the hab. Anything else, you talk to me.",
        "There's a tab on my board nobody's paid. Man shipped out and left it. I'd take it kindly if somebody settled it."
       ],
       "rumours": [
        "Something out on the ice has been transmitting since before I got here. Nobody's ever gone to look twice.",
        "There's people living in the glacier east of here. They come in once a season, buy filters, say nothing.",
        "The administrator's reactor is browning out. She won't say it, but she's frightened."
